# Copy to .env and edit. Every setting is optional — the defaults below are
# what the generator uses when .env is absent. Real environment variables
# take priority over this file. .env is git-ignored; .env.example is not.

# ── Where the vault is written ───────────────────────────────────────────────
# Relative paths resolve against the repo root, not your shell's location.
VAULT_PATH=../Tadabbur

# Folder inside the vault holding the indexes, Names of Allah and Personalities.
EXPLORE_DIR=0 - Explore

# ── Audio ────────────────────────────────────────────────────────────────────
# api   → stream from a public CDN. Nothing to download. Use this for the website.
# local → file:// links to mp3s on this machine. Use this for offline Obsidian.
# r2    → your own bucket or CDN. Requires AUDIO_R2_BASE_URL.
AUDIO_MODE=api

# --- api mode
AUDIO_API_BASE_URL=https://cdn.islamic.app/quran/audio
AUDIO_API_RECITER=ar.alafasy

# --- r2 mode (leave AUDIO_MODE=r2 and set a real host; the build fails if it is empty)
AUDIO_R2_BASE_URL=

# --- local mode
# Recitation audio is NOT distributed with this repo — see docs/LICENSES.md.
# Point this at your own copy. Two folder shapes are supported:
#   flat    002255.mp3    every file in one folder (everyayah-style)
#   nested  002/255.mp3   one folder per surah
AUDIO_LOCAL_PATH=data/AlafasyAudio
AUDIO_LOCAL_LAYOUT=flat

# ── Assets ───────────────────────────────────────────────────────────────────
THUMBNAILS_SRC=thumbnailGenerator/thumbnails
VAULT_FILES_SRC=vault_files
